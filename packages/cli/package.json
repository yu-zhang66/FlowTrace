{
  "name": "@flowtrace/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "flowtrace": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@flowtrace/core": "workspace:*",
    "@flowtrace/collector": "workspace:*",
    "@flowtrace/adapter": "workspace:*",
    "@flowtrace/ai": "workspace:*",
    "@flowtrace/runner": "workspace:*",
    "@flowtrace/reporter": "workspace:*",
    "commander": "^11.1.0",
    "chalk": "^5.3.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/js-yaml": "^4.0.9",
    "typescript": "^5.3.3"
  }
}
